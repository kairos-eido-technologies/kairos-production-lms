{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/dist/client/assets/$1"
    },
    {
      "src": "/logo.png",
      "dest": "/dist/client/logo.png"
    },
    {
      "src": "/2.png",
      "dest": "/dist/client/2.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
