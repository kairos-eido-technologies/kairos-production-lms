{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/dist/client/assets/$1"
    },
    {
      "src": "/logo.png",
      "dest": "/dist/client/logo.png"
    },
    {
      "src": "/2.png",
      "dest": "/dist/client/2.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
